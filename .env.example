# Server
WEB_PORT=3000
HOST=localhost

# Data paths (defaults are fine for local development)
# DATA_DIR=./data
# DB_PATH=./data/dashboard.db
# TABS_DIR=./tabs
# WIDGETS_DIR=./data/widgets
# SCRIPTS_DIR=./data/scripts

# Isolated demo (safe to reset with POST /api/demo/reset)
# DEMO_DB_PATH=./data/demo.db
# DEMO_TABS_DIR=./data/demo-tabs
# DEMO_AI_MODE=mock
# Set to 1 to disable all writes in the public demo.
# DEMO_READ_ONLY=0

# OpenCode CLI (optional, only needed for the real dashboard AI features)
# OPENCODE_BIN=opencode
# OPENCODE_MODEL=opencode-go/minimax-m2.7

# Password for the OpenCode dashboard panel (empty = no protection)
# DASHBOARD_OPENCODE_PASSWORD=
