{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "sh demo-static/build.sh",
  "installCommand": "echo 'static build needs no dependencies'",
  "outputDirectory": "demo-static/public",
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://dynamic-dashboard.ednormand.fr/$1",
      "permanent": true
    }
  ]
}
